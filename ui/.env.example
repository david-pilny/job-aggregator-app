# Copy to .env. All values are optional; the defaults assume this folder sits next to the
# Python pipeline (../config.yaml, ../jobs.sqlite).

# Path to the pipeline's SQLite file (relative paths resolve from the ui/ folder)
NUXT_DB_PATH=../jobs.sqlite

# Where and how "Run now" starts the pipeline
NUXT_PIPELINE_CWD=..
NUXT_PIPELINE_COMMAND=uv run jobs run
