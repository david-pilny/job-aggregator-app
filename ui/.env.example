# Copy to .env. All values are optional; the defaults assume this folder sits next to the
# Python pipeline (../config.yaml, ../jobs.sqlite).

# Path to the pipeline's SQLite file (relative paths resolve from the ui/ folder)
NUXT_DB_PATH=../jobs.sqlite

# Where and how "Run now" and the scheduled task start the pipeline
NUXT_PIPELINE_CWD=..
NUXT_PIPELINE_COMMAND=uv run jobs run

# Cron expression for the in-process schedule (runs while the UI server is up).
# Default: 07:00 daily. Set to an empty string to disable. Restart the server after changing it.
NUXT_PIPELINE_SCHEDULE=0 7 * * *
